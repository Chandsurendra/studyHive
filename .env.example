# Database Configuration
# Replace with your DB credentials!
#DATABASE_URL="libsql://db-name-user.turso.io"
#DATABASE_AUTH_TOKEN=""
# A local DB can also be used in dev as well
DATABASE_URL="file:local.db"

# Better Auth Configuration
BETTER_AUTH_SECRET=your-secret-key-here
BETTER_AUTH_URL=http://localhost:5173 # Base URL of your app

# Social Provider Configuration
# GitHub OAuth App Settings
# Create OAuth app at: https://github.com/settings/applications/new
# Authorization callback URL: http://localhost:5173/api/auth/sign-in/github
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Google Cloud Console Settings
# Create OAuth app at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/api/auth/sign-in/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Note: Better Auth automatically handles OAuth callbacks at:
# /api/auth/sign-in/github
# /api/auth/sign-in/google
# Make sure these exact URLs are added to your OAuth apps